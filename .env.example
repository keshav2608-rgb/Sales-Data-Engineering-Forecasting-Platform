# Copy this file to .env and fill in values as needed.
# LOCAL mode (default) requires NONE of the cloud variables below - the
# pipeline runs entirely on DuckDB with zero configuration.

ENVIRONMENT=local
# Set to `cloud` to enable BigQuery (requires the three GOOGLE_* vars below).

DATABASE_URL=

# --- Google Cloud / BigQuery (only needed for ENVIRONMENT=cloud) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_DATASET=sales_analytics

DATA_SOURCE_URL=

FORECAST_HORIZON=6
